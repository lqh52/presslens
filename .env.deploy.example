# GitHub repository name, omitted only for a <username>.github.io repository.
NEXT_PUBLIC_BASE_PATH=/presslens

# Public media endpoint used by the static application.
NEXT_PUBLIC_MEDIA_ASSET_BASE_URL=

# Used only by the upload script. Never prefix this with NEXT_PUBLIC_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-your-local-shell-or-github-secret
SUPABASE_BUCKET=presslens-media
