{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PressLens tactical sequence annotation",
  "type": "object",
  "required": [
    "is_build_up",
    "pressing_trigger",
    "press_direction",
    "central_option",
    "outcome",
    "description"
  ],
  "properties": {
    "is_build_up": { "type": "boolean" },
    "team_in_possession": { "type": ["string", "null"] },
    "pressing_team": { "type": ["string", "null"] },
    "pressing_trigger": {
      "enum": [
        "back_pass",
        "goalkeeper_receive",
        "centre_back_receive",
        "poor_touch",
        "slow_pass",
        "sideline_receive",
        "other",
        "none"
      ]
    },
    "press_direction": {
      "enum": ["inside", "outside", "backward", "undetermined", "none"]
    },
    "central_option": {
      "enum": ["available", "screened", "marked", "off_camera", "undetermined"]
    },
    "outcome": {
      "enum": [
        "forced_wide",
        "forced_backward",
        "forced_long",
        "turnover_won",
        "played_through",
        "no_clear_outcome",
        "not_applicable"
      ]
    },
    "visible_players": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 22
    },
    "description": { "type": "string", "minLength": 5 },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
