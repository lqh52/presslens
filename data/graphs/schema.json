{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PressLens canonical frame graph",
  "type": "object",
  "required": ["coordinate_system", "nodes", "source"],
  "properties": {
    "coordinate_system": {
      "const": {
        "origin": "possession_team_own_goal_centre",
        "x_axis": "toward_opponent_goal",
        "y_axis": "left_to_right_from_possession_team_view",
        "pitch_length": 1.0,
        "pitch_width": 1.0
      }
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["synthetic", "video"] },
        "clip_id": { "type": ["string", "null"] },
        "time_seconds": { "type": ["number", "null"] }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 23,
      "items": {
        "type": "object",
        "required": ["id", "kind", "x", "y", "visible", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["player", "ball"] },
          "team": { "enum": ["possession", "pressing", "none"] },
          "role": {
            "enum": ["goalkeeper", "player", "referee", "other", "ball"]
          },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "vx": { "type": ["number", "null"] },
          "vy": { "type": ["number", "null"] },
          "visible": { "type": "boolean" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "controls_ball": { "type": "boolean" }
        }
      }
    }
  }
}
